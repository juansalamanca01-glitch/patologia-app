		{
			"name": "3. Informes",
			"item": [
				{
					"name": "Crear informe (Biopsia de Piel)",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"url": {
							"raw": "{{base_url}}/api/informes/",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"informes",
								""
							]
						},
						"description": "Crea un informe en estado borrador. El backend genera la descripción macroscópica en texto_generado. El backend asigna el número de petición (P-AÑO-NNNNN): no se envía. numero_orden_externa es opcional. Supone que la patología 1 es \"Biopsia de Piel\", como ocurre con una base de datos nueva y seed_data. Guarda el id en {{informe_id}}.",
						"body": {
							"mode": "raw",
							"raw": "{\n  \"numero_orden_externa\": \"ORD-EJEMPLO-001\",\n  \"patologia\": 1,\n  \"tipo_muestra\": \"Biopsia escisional\",\n  \"datos_ingresados\": {\n    \"localizacion\": \"Espalda región escapular derecha\",\n    \"tipo_muestra\": \"Escisional\",\n    \"dimensiones\": \"2.5 x 1.8 x 0.6 cm\",\n    \"color\": \"Pigmentado\",\n    \"bordes\": \"Irregulares\",\n    \"superficie\": \"Rugosa con ulceración central\",\n    \"hallazgos_adicionales\": \"Lesión nodular hiperpigmentada sin sangrado activo\"\n  },\n  \"notas\": \"Muestra fijada en formol al 10% remitida por Dermatología\"\n}"
						}
					},
					"response": [],
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"if (pm.response.code === 200 || pm.response.code === 201) {",
									"    pm.collectionVariables.set('informe_id', pm.response.json().id);",
									"    console.log('Guardado en informe_id: ' + pm.response.json().id);",
									"}"
								]
							}
						}
					]
				},
