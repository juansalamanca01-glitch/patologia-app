{
	"info": {
		"_postman_id": "8bbc54a1-patologia-app-collection",
		"name": "PathoLab API - Informes de Patología",
		"description": "Colección para probar la API de PathoLab.\n\nUso: 1) ejecuta \"Login (patólogo)\", que guarda el token en {{access_token}}. 2) Ejecuta las demás peticiones en orden: \"Crear informe\" guarda {{informe_id}} y \"Crear publicación\" guarda {{publicacion_id}}.\n\nTodas las peticiones usan el token de la colección (Authorization: Bearer), excepto el login. Los listados vienen paginados de 20 en 20 (?page=2).",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"auth": {
		"type": "bearer",
		"bearer": [
			{
				"key": "token",
				"value": "{{access_token}}",
				"type": "string"
			}
		]
	},
	"variable": [
		{
			"key": "base_url",
			"value": "http://127.0.0.1:8000",
			"type": "string"
		},
		{
			"key": "access_token",
			"value": "",
			"type": "string"
		},
		{
			"key": "informe_id",
			"value": "",
			"type": "string"
		},
		{
			"key": "publicacion_id",
			"value": "",
			"type": "string"
		}
	],
	"item": [
		{
			"name": "1. Autenticación",
			"item": [
				{
					"name": "Login (patólogo)",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"url": {
							"raw": "{{base_url}}/api/auth/login/",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"auth",
								"login",
								""
							]
						},
						"description": "Inicia sesión con el usuario de prueba patologo1 y guarda el token en {{access_token}}. Para probar otros roles usa admin/admin1234 o auditor1/auditor1234.",
						"body": {
							"mode": "raw",
							"raw": "{\n  \"username\": \"patologo1\",\n  \"password\": \"patologo1234\"\n}"
						},
						"auth": {
							"type": "noauth"
						}
					},
					"response": [],
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"if (pm.response.code === 200 || pm.response.code === 201) {",
									"    pm.collectionVariables.set('access_token', pm.response.json().access);",
									"    console.log('Guardado en access_token: ' + pm.response.json().access);",
									"}"
								]
							}
						}
					]
				},
				{
					"name": "Ver mi perfil",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/api/auth/perfil/",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"auth",
								"perfil",
								""
							]
						},
						"description": "Datos del usuario autenticado, incluido su rol."
					},
					"response": []
				}
			]
		},
