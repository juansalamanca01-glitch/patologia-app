# Django Backend Environment Configuration
# Copia este archivo como ".env" (no lo subas a git) y ajusta los valores reales.
# SECRET_KEY es obligatoria: el backend no arranca sin ella. Genera una propia con:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
# Si DEBUG no se define, queda en False (modo produccion). Usa DEBUG=True solo en desarrollo.
SECRET_KEY=django-insecure-change-this-secret-key-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database (optional for PostgreSQL; default uses SQLite)
# DB_NAME=patologia_db
# DB_USER=postgres
# DB_PASSWORD=postgres
# DB_HOST=localhost
# DB_PORT=5432

# CORS: orígenes del frontend permitidos para llamar a la API (separados por coma).
# En producción NO dejar esto vacío ni usar "*".
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# HTTPS / cookies seguras (activar en producción con certificado real)
SECURE_SSL_REDIRECT=False

# Encabezado del PDF de los informes (opcional). Sin estas variables se usa el
# encabezado de demostración. La dirección va en una sola línea, con la ciudad.
# Si LABORATORIO_TELEFONO está vacío, el PDF no imprime la línea del teléfono.
# Ejemplo ficticio (no uses datos de un laboratorio real sin autorización):
# LABORATORIO_NOMBRE=Laboratorio Ficticio de Anatomía Patológica
# LABORATORIO_DIRECCION=Calle Falsa 123, Santiago de Cali, Colombia
# LABORATORIO_TELEFONO=000 000 0000
