# Django Backend Environment Configuration
# Copia este archivo como ".env" (no lo subas a git) y ajusta los valores reales.
SECRET_KEY=django-insecure-change-this-secret-key-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database (optional for PostgreSQL; default uses SQLite)
# DB_NAME=patologia_db
# DB_USER=postgres
# DB_PASSWORD=postgres
# DB_HOST=localhost
# DB_PORT=5432

# CORS: orígenes del frontend permitidos para llamar a la API (separados por coma).
# En producción NO dejar esto vacío ni usar "*".
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# HTTPS / cookies seguras (activar en producción con certificado real)
SECURE_SSL_REDIRECT=False
