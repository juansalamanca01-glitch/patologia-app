{
  "editor.formatOnSave": true,

  "prettier.requireConfig": true,
  "prettier.prettierPath": "./frontend/node_modules/prettier",
  "[javascript]": { "editor.defaultFormatter": "esbenp.prettier-vscode" },
  "[javascriptreact]": { "editor.defaultFormatter": "esbenp.prettier-vscode" },
  "[css]": { "editor.defaultFormatter": "esbenp.prettier-vscode" },
  "[html]": { "editor.defaultFormatter": "esbenp.prettier-vscode" },
  "[json]": { "editor.defaultFormatter": "esbenp.prettier-vscode" },

  "eslint.workingDirectories": ["frontend"],

  "ruff.path": ["${workspaceFolder}/backend/venv/Scripts/ruff.exe", "${workspaceFolder}/backend/venv/bin/ruff"],
  "[python]": {
    "editor.defaultFormatter": "charliermarsh.ruff",
    "editor.codeActionsOnSave": { "source.organizeImports.ruff": "explicit" }
  }
}
